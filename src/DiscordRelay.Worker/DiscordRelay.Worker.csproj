<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>PDB.Worker</AssemblyName>
    <ApplicationIcon>..\..\assets\pdb.ico</ApplicationIcon>
    <RootNamespace>DashyDen.DiscordRelay.Worker</RootNamespace>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS8600;CS8603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscordRelay.Core\DiscordRelay.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Compile Include="..\AvatarResolver.cs" Link="Infrastructure\AvatarResolver.cs" />
  </ItemGroup>
</Project>
